**/__pycache__/
*.py[cod]

# OSRM raw source (not needed, precompiled .osrm files are tracked)
/osrm_data/*.pbf

# Generated map HTML files (regenerable via scripts)
/results/maps/

# LaTeX build artifacts (el .pdf y el .bbl si se versionan)
*.aux
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.toc
*.idx
*.ind
*.ilg
*.synctex.gz
*.synctex(busy)

